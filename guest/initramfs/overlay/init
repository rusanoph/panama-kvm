#!/bin/busybox sh
set -eu

busybox=/bin/busybox

"$busybox" mount -t devtmpfs devtmpfs /dev
"$busybox" mount -t proc proc /proc
"$busybox" mount -t sysfs sysfs /sys

printf 'PanamaKVM smoke guest booted successfully. [PANAMAKVM_SMOKE_OK]\n'
"$busybox" uname -a
"$busybox" grep -m1 'model name' /proc/cpuinfo || true
"$busybox" free -m
"$busybox" sync
exec "$busybox" reboot -f
